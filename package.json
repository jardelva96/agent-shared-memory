{
  "name": "agent-shared-memory",
  "version": "1.4.0",
  "description": "Shared memory and coordination for AI coding agents from any vendor: file reservations enforced by editor hooks, safe edits by symbol, a review-gated task queue, and a live multi-machine hub.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-memory": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "README.pt-BR.md",
    "CHANGELOG.md",
    "AGENT_PROTOCOL.md",
    "LICENSE",
    "AGENT_PROTOCOL.pt-BR.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "test": "node --test --import tsx tests/*.test.ts",
    "start": "node dist/cli/main.js",
    "example": "tsx examples/demo.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "coding-agents",
    "shared-memory",
    "coordination",
    "cli",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "git-watcher",
    "dashboard",
    "file-reservations",
    "code-navigation",
    "symbol-editing",
    "claude-code-hooks",
    "multi-machine"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
