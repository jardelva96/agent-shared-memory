{
  "name": "agent-shared-memory",
  "version": "1.2.0",
  "description": "Local-first shared memory and task coordination for multiple AI coding agents, with CLI, MCP server, Git watcher, review gates and live dashboard.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-memory": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "test": "node --test --import tsx tests/*.test.ts",
    "start": "node dist/cli/main.js",
    "example": "tsx examples/demo.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "coding-agents",
    "shared-memory",
    "coordination",
    "cli",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "git-watcher",
    "dashboard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
